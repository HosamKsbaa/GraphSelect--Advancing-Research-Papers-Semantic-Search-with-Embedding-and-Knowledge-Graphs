<div style="flex: 1; display: flex; flex-direction: column; gap: 16px;">
  <p style="font-size: 0.95rem; color: var(--text-secondary); max-width: 900px;">
    Semantic coverage evaluation C(RQ_i) across formulated research questions, identifying grounded evidence vs. open frontiers.
  </p>
  <div class="grid-2" style="flex: 1;">
    {% for rq in research_questions[:4] %}
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span class="slide-category">{{ rq.rq_id }}</span>
          <span class="brand-badge" style="font-size: 0.75rem; background: {{ 'var(--accent-emerald)' if rq.status == 'grounded' else 'var(--accent-amber)' }};">
            {{ rq.status }}
          </span>
        </div>
        <h4 style="font-size: 1.05rem; color: var(--text-primary); line-height: 1.4; margin-bottom: 12px;">
          {{ rq.finer_text }}
        </h4>
      </div>
      <div>
        <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 4px;">
          <span style="color: var(--text-muted);">Semantic Coverage: {{ (rq.coverage_score * 100)|round|int }}%</span>
          <span style="color: var(--accent-cyan); font-family: var(--font-mono);">{{ rq.grounded_paper_count }} papers</span>
        </div>
        <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden;">
          <div style="width: {{ (rq.coverage_score * 100)|round|int }}%; height: 100%; background: var(--gradient-primary);"></div>
        </div>
      </div>
    </div>
    {% else %}
    <div class="card" style="grid-column: span 2; display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
      No research questions indexed for this project campaign.
    </div>
    {% endfor %}
  </div>
</div>
