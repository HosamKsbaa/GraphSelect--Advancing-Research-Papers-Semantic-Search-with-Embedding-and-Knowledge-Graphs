<div style="flex: 1; display: flex; flex-direction: column; justify-content: center; max-width: 960px;">
  <div style="display: flex; gap: 8px; margin-bottom: 12px;">
    <span class="slide-category">{{ domain }}</span>
    <span class="brand-badge" style="background: rgba(255,255,255,0.1); border: 1px solid var(--border-color); font-size: 0.75rem;">Stage: {{ workflow_stage }}</span>
  </div>
  <h1 class="hero-heading" style="font-size: 2.8rem; font-weight: 900; line-height: 1.15; color: var(--text-primary); margin-bottom: 16px;">
    {{ project_name }}
  </h1>
  <p class="slide-subtitle" style="font-size: 1.15rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 28px;">
    {{ description if description else "Autonomous Literature Review System (ALRS v2) synthesizing graph-grounded empirical findings with zero citation hallucination." }}
  </p>
  <div style="display: flex; gap: 24px; padding-top: 16px; border-top: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
    <div><strong>Campaign:</strong> {{ project_id }}</div>
    <div><strong>Created:</strong> {{ creation_date[:10] if creation_date else "2026-09-09" }}</div>
    <div><strong>Architecture:</strong> Neo4j Epistemic Graph + Google ADK</div>
  </div>
</div>
