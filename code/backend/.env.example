# ALRS v2 Backend Environment Variables
# Copy this file to .env and fill in your values

# === Google Gemini / Vertex AI ===
USE_VERTEX_AI=True
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
GEMINI_API_KEY=your_gemini_api_key_here

# === OpenAlex API (Polite Pool) ===
OPENALEX_API_KEY=your_openalex_api_key_here
OPENALEX_MAILTO=researcher@university.edu
OPENALEX_EMAIL=researcher@university.edu

# === Neo4j Epistemic SSOT (Graph Database) ===
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# === Embedded SQLite Telemetry (WAL Mode) ===
SQLITE_TELEMETRY_PATH=data/telemetry.sqlite

# === Application Settings ===
LOG_RETENTION_HOURS=24
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
OPENALEX_RATE_LIMIT=9.0
APP_HOST=0.0.0.0
APP_PORT=8000

# === ADK / Agent Configuration ===
ADK_MODEL_NAME=gemini-3.5-flash
ADK_TIER1_MODEL=gemini-2.5-flash
ADK_TIER2_MODEL=gemini-3.5-flash-lite

TOKEN_BUDGET_DEFAULT=500000
TOKEN_BUDGET_WARN_THRESHOLD=0.8
MAX_RESEARCH_QUESTIONS=6
SIMILARITY_THRESHOLD_DEFAULT=0.6
PROJECTS_DIR=projects
CAMPAIGNS_DIR=data/campaigns
PROVENANCE_CROPS_DIR=data/provenance/crops
TELEMETRY_DIR=data/telemetry
